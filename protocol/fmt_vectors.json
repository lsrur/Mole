{
  "comment": "TEST-08: vectores del formateador de llaves del host (spec §7.2). Autoridad sobre el comportamiento de mole-fmt. Cambiarlos es cambiar el contrato.",
  "vectors": [
    { "id": "fmt-basic", "fmt": "x={}", "args": [{ "t": "i32", "v": 5 }], "expected": "x=5" },
    { "id": "fmt-two-args", "fmt": "crudo={} v={:.2}", "args": [{ "t": "i32", "v": 1024 }, { "t": "f32", "bits_hex": "7b141e40" }], "expected": "crudo=1024 v=2.47" },
    { "id": "fmt-hex-upper-pad", "fmt": "{:04X}", "args": [{ "t": "u16", "v": 42 }], "expected": "002A" },
    { "id": "fmt-hex-lower", "fmt": "CRC {:04x}", "args": [{ "t": "u16", "v": 48879 }], "expected": "CRC beef" },
    { "id": "fmt-hex-negativo-bits", "fmt": "{:X}", "args": [{ "t": "i8", "v": -1 }], "expected": "FF" },
    { "id": "fmt-bin-alt", "fmt": "{:#b}", "args": [{ "t": "u8", "v": 5 }], "expected": "0b101" },
    { "id": "fmt-octal", "fmt": "{:o}", "args": [{ "t": "u8", "v": 8 }], "expected": "10" },
    { "id": "fmt-hex-alt", "fmt": "{:#x}", "args": [{ "t": "u32", "v": 255 }], "expected": "0xff" },
    { "id": "fmt-signo-mas", "fmt": "{:+} {:+}", "args": [{ "t": "i32", "v": 7 }, { "t": "i32", "v": -7 }], "expected": "+7 -7" },
    { "id": "fmt-ancho-espacios", "fmt": "[{:6}]", "args": [{ "t": "i32", "v": 42 }], "expected": "[    42]" },
    { "id": "fmt-cero-decimal-negativo", "fmt": "{:05}", "args": [{ "t": "i32", "v": -42 }], "expected": "-0042" },
    { "id": "fmt-precision-f64", "fmt": "{:.3}", "args": [{ "t": "f64", "bits_hex": "0000000000000440" }], "expected": "2.500" },
    { "id": "fmt-f32-default", "fmt": "{}", "args": [{ "t": "f32", "bits_hex": "0000c03f" }], "expected": "1.5" },
    { "id": "fmt-nan", "fmt": "{}", "args": [{ "t": "f32", "bits_hex": "0000c07f" }], "expected": "NaN" },
    { "id": "fmt-infinitos", "fmt": "{} {}", "args": [{ "t": "f32", "bits_hex": "0000807f" }, { "t": "f32", "bits_hex": "000080ff" }], "expected": "inf -inf" },
    { "id": "fmt-cero-negativo", "fmt": "{}", "args": [{ "t": "f32", "bits_hex": "00000080" }], "expected": "-0" },
    { "id": "fmt-subnormal-pinned", "fmt": "{:.3}", "args": [{ "t": "f64", "bits_hex": "0100000000000000" }], "expected": "0.000" },
    { "id": "fmt-precision-f32-neg", "fmt": "{:.1}", "args": [{ "t": "f32", "bits_hex": "8fc21ec0" }], "expected": "-2.5" },
    { "id": "fmt-float-cero-pad", "fmt": "{:07.2}", "args": [{ "t": "f32", "bits_hex": "0000c0bf" }], "expected": "-001.50" },
    { "id": "fmt-bool", "fmt": "{}", "args": [{ "t": "bool", "v": true }], "expected": "true" },
    { "id": "fmt-sym-conocido", "fmt": "tag={}", "args": [{ "t": "sym", "v": 5 }], "syms": { "5": "net" }, "expected": "tag=net" },
    { "id": "fmt-sym-desconocido", "fmt": "{}", "args": [{ "t": "sym", "v": 9 }], "expected": "<sym#9>" },
    { "id": "fmt-str-runtime", "fmt": "{}", "args": [{ "t": "str", "v": "hola" }], "expected": "hola" },
    { "id": "fmt-str-utf8-invalido", "fmt": "{}", "args": [{ "t": "str", "bytes_hex": "ff61" }], "expected": "�a" },
    { "id": "fmt-ptr", "fmt": "{}", "args": [{ "t": "ptr", "v": 1073418804 }], "expected": "0x3ffb1234" },
    { "id": "fmt-escapes", "fmt": "{{}} {}", "args": [{ "t": "i32", "v": 1 }], "expected": "{} 1" },
    { "id": "fmt-arg-faltante", "fmt": "a={} b={}", "args": [{ "t": "i32", "v": 1 }], "expected": "a=1 b={!arg1}", "must_fail": "arg_count_mismatch" },
    { "id": "fmt-spec-malformada", "fmt": "{:q}", "args": [{ "t": "i32", "v": 1 }], "expected": "{!spec}" },
    { "id": "fmt-llave-sin-cerrar", "fmt": "x={", "args": [], "expected": "x={!fmt}" },
    { "id": "fmt-struct", "fmt": "s={}", "args": [{ "t": "struct", "type_id": 1, "fields": [{ "t": "u8", "v": 17 }, { "t": "u16", "v": 8755 }] }], "syms": { "2": "a", "3": "b" }, "types": [{ "type_id": 1, "name": "Sens", "fields": [{ "name_sym": 2, "wire": "u8" }, { "name_sym": 3, "wire": "u16" }] }], "expected": "s=Sens{a=17, b=8755}" }
  ]
}
